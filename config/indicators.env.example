# Indicator history cron config
# Indicator names go one-per-line AFTER the @indicators marker line.

MARKET_IDS=120
RESOLUTIONS=15m,30m,1h
CANDLE_COUNT=200
NETWORK=mainnet

# Protect tick endpoint: ?action=indicators_tick&secret=...
CRON_SECRET=change-me

# MySQL/MariaDB DSN
DB_DSN=mysql://bot:botassistant@127.0.0.1:3306/botassistant

# URL for cron loop (local PHP server or your host)
ENDPOINT_URL=http://127.0.0.1:8080/api.php

# Interval seconds for Task Scheduler (botassistant-ind-pipeline)
# Full pipeline: snapshot + DeepSeek + report. Keep interval >= 300.
CRON_INTERVAL_SEC=300

# Cron: php scripts/indicators_pipeline_cli.php
#   1) snapshot  2) DeepSeek agent  3) report → MySQL indicator_reports

@indicators
MACD(12,26,9) cross
RSI(14) 30/70
SMA(10/30) cross
EMA(12/26) cross
Bollinger(20,2) bounce
ROC(10) zero-cross
Momentum(10) flip
ATR(14) pct
RV(48) log
Bollinger(20,2) width
