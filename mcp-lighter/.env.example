# Lighter trading credentials (never commit real keys)
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
# testnet: https://testnet.zklighter.elliot.ai

LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=2
LIGHTER_API_PRIVATE_KEY=

# Optional: resolve account_index via L1 address
LIGHTER_L1_ADDRESS=

# Default max slippage for market orders (0.005 = 0.5%)
LIGHTER_MAX_SLIPPAGE=0.005

# Telegram notify bot (optional)
# 1) @BotFather → /newbot → copy token
# 2) Write any message to your bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy chat.id into TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek API (optional — never commit real keys)
# Platform: https://platform.deepseek.com → API Keys
# For Cursor BYOK prefer Settings → Models (not this file).
# Base URL: https://api.deepseek.com
# Models: deepseek-v4-flash | deepseek-v4-pro
# Legacy (retire ~2026-07-24): deepseek-chat | deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Primary analysis (pipeline): flash. 2m loop / clarify: pro.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# MySQL (shared with PHP indicators.env / mcp botassistant-mysql)
DB_DSN=mysql://bot:botassistant@127.0.0.1:3306/botassistant
